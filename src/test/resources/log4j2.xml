<Configuration status="WARN">
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern = "[%d{yyyy-MM-dd HH:mm:ss}] [%p] [%t] %c{1} - %m%n"/>
		</Console>
		
		<File name="File" fileName="logs/test.log">
			<PatternLayout pattern = "[%d{yyyy-MM-dd HH:mm:ss}] [%p] [%t] %c{1} - %m%n"/>
		</File>
	</Appenders>
	<Loggers>
		<Root level="INFO">
			<AppenderRef ref="Console"/>
			<AppenderRef ref="File"/>
		</Root>
	</Loggers>
</Configuration>